# Postgres connection string. Local: docker compose up -d
DATABASE_URL=postgres://panda:panda@localhost:5432/pandasolution
# Used only by the test suite
TEST_DATABASE_URL=postgres://panda:panda@localhost:5432/pandasolution_test

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin the browser uses (the Vite dev server proxies /api to the API)
BETTER_AUTH_URL=http://localhost:8080

# Public web origin used in share links (defaults to BETTER_AUTH_URL)
# PUBLIC_APP_URL=https://pandasolution.ng

# API server port
PORT=8787
